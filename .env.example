NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=
SANITY_REVALIDATE_SECRET=

NEXT_PUBLIC_SITE_URL=
RESEND_API_KEY=

# Remitente del formulario de contacto. Requiere el dominio verificado en Resend
# (ej: "Gallego Cazaux <contacto@gallegocazaux.com>"). Sin esta variable se usa
# el remitente de sandbox, que solo entrega al mail dueño de la cuenta de Resend.
RESEND_FROM=
# Casilla que recibe las consultas. Por defecto gallegocazaux@gmail.com
CONTACT_TO=

# Código de verificación de Google Search Console (solo el valor del content,
# sin la etiqueta meta). Opcional: si se verifica por DNS, no hace falta.
GOOGLE_SITE_VERIFICATION=
