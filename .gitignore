# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ai / dev tooling — not needed in production
.playwright-mcp/
# Solo la raíz: son los screenshots de verificación. Sin la barra inicial esto
# ignora también los assets del sitio (íconos, imágenes de public/)
/*.png
/*.jpeg
.claude/settings.local.json
openspec/

# material de trabajo del cliente — fotos originales, PDFs y documentación que
# se le entrega. No es código ni assets del sitio: lo del sitio vive en public/.
# Mismo criterio de la barra inicial que arriba: ancla a la raíz para no ignorar
# carpetas con nombres parecidos anidadas en el proyecto
/Imagenes-Gallego-Cazaux/
/propiedades-gallegocazaux/
/guia-sanity/
# Incluye la guía del CMS que se genera en la raíz, además de los PDFs sueltos
/*.pdf

.vercel
